fill = "transparent",
colour = NA),
legend.key = element_rect(
fill = "transparent",
colour = NA),
legend.text = element_text(
colour = "white",
size = 12),
axis.text = element_text(
colour = "white",
size = 12),
axis.title = element_text(
colour = "white",
size = 14),
axis.line = element_line(
colour = "white"),
axis.ticks = element_line(
colour = "white"),
panel.grid = element_blank())
ggsave(
"species_richness_treatment.png",
plot = richness_plot_slide,
width = 7,
height = 5,
units = "in",
dpi = 600,
bg = "transparent")
richness_plot = ggplot(
richness_long,
aes(
x = guild,
y = richness,
fill = treatment)) +
geom_boxplot(
position = position_dodge(
width = 0.7),
width = 0.6,
colour = "white",
outlier.shape = NA,
alpha = 1) +
geom_point(
aes(
group = treatment),
shape = 21,
colour = "white",
stroke = 0.7,
size = 4,
position = position_jitterdodge(
jitter.width = 0.08,
dodge.width = 0.7)) +
scale_fill_manual(
values = treatment_colours) +
labs(
x = NULL,
y = "Species richness",
fill = NULL) +
theme_bw()
# ==========================================================
# 6. Plant and pollinator richness together
# ==========================================================
richness_long = site_richness %>%
pivot_longer(
cols = c(
plant_richness,
pollinator_richness),
names_to = "guild",
values_to = "richness") %>%
mutate(
guild = recode(
guild,
plant_richness = "Plants",
pollinator_richness = "Pollinators"))
richness_plot = ggplot(
richness_long,
aes(
x = guild,
y = richness,
fill = treatment)) +
geom_boxplot(
position = position_dodge(
width = 0.7),
width = 0.6,
colour = "white",
outlier.shape = NA,
alpha = 1) +
geom_point(
aes(
group = treatment),
shape = 21,
colour = "white",
stroke = 0.7,
size = 4,
position = position_jitterdodge(
jitter.width = 0.08,
dodge.width = 0.7)) +
scale_fill_manual(
values = treatment_colours) +
labs(
x = NULL,
y = "Species richness",
fill = NULL) +
theme_bw()
richness_plot
richness_plot_slide = richness_plot +
theme(
panel.background = element_rect(
fill = "transparent",
colour = NA),
plot.background = element_rect(
fill = "transparent",
colour = NA),
legend.background = element_rect(
fill = "transparent",
colour = NA),
legend.key = element_rect(
fill = "transparent",
colour = NA),
legend.text = element_text(
colour = "white",
size = 12),
axis.text = element_text(
colour = "white",
size = 12),
axis.title = element_text(
colour = "white",
size = 14),
axis.line = element_line(
colour = "white"),
axis.ticks = element_line(
colour = "white"),
panel.grid = element_blank())
ggsave(
"species_richness_treatment.png",
plot = richness_plot_slide,
width = 7,
height = 5,
units = "in",
dpi = 600,
bg = "transparent")
############################################################
# Summer School: Network Analysis in R
# Case Study 2: Plant-pollinator networks
# 3. Comparison of visitation activity between treatments
############################################################
# ==========================================================
# 1. Load libraries
# ==========================================================
library(readr)    # Read CSV files
library(dplyr)    # Data manipulation
library(ggplot2)  # Data visualisation
library(nlme)     # GLS models and temporal autocorrelation
# ==========================================================
# 2. Load data
# ==========================================================
networks_long = read_csv2(
"Data/Processed/visitation.networks.long.csv")
# ==========================================================
# 3. Number of visits
# ==========================================================
# Calculate the total number of visits in each monthly network
visits = networks_long %>%
group_by(
site,
month,
treatment,
network_id) %>%
summarise(
visits = sum(visits),
.groups = "drop")
visits
# Summarise number of visits by treatment
visits_summary = visits %>%
group_by(treatment) %>%
summarise(
mean_visits = mean(visits),
sd_visits = sd(visits),
.groups = "drop")
visits_summary
# Compare number of visits between treatments
plot_visits = ggplot(
visits,
aes(
x = treatment,
y = visits)) +
geom_boxplot(
aes(fill = treatment),
width = 0.5,
outlier.shape = NA,
alpha = 0.4) +
geom_jitter(
aes(colour = treatment),
width = 0.08,
size = 4,
alpha = 0.4) +
scale_fill_manual(
values = c(
"Restored" = "#3A923A",
"Unrestored" = "#595959")) +
scale_colour_manual(
values = c(
"Restored" = "#3A923A",
"Unrestored" = "#595959")) +
labs(
x = "Treatment",
y = "Number of visits") +
theme_bw() +
theme(
legend.position = "none")
plot_visits
# ==========================================================
# 4. Explore temporal variation
# ==========================================================
# Plot monthly variation in visits between treatments
plot_visits_time = ggplot(
visits,
aes(
x = factor(month),
y = visits,
fill = treatment)) +
geom_boxplot(
width = 0.7,
outlier.shape = NA,
alpha = 0.5,
position = position_dodge(width = 0.8)) +
geom_jitter(
aes(colour = treatment),
size = 2.5,
alpha = 0.7,
position = position_jitterdodge(
jitter.width = 0.08,
dodge.width = 0.8)) +
scale_fill_manual(
values = c(
"Restored" = "#3A923A",
"Unrestored" = "#595959")) +
scale_colour_manual(
values = c(
"Restored" = "#3A923A",
"Unrestored" = "#595959")) +
labs(
x = "Month",
y = "Number of visits",
fill = "Treatment",
colour = "Treatment") +
theme_bw()
plot_visits_time
# ==========================================================
# 10. Combine degree plots for slides
# ==========================================================
plant_degree_slide = plant_degree_boxplot +
labs(
x = NULL,
y = "Mean degree",
title = "Plants") +
theme(
panel.background = element_rect(
fill = "transparent",
colour = NA),
plot.background = element_rect(
fill = "transparent",
colour = NA),
panel.grid = element_blank(),
plot.title = element_text(
colour = "white",
size = 16,
face = "bold",
hjust = 0.5),
axis.text = element_text(
colour = "white",
size = 12),
axis.title = element_text(
colour = "white",
size = 14),
axis.line = element_line(
colour = "white"),
axis.ticks = element_line(
colour = "white"))
pollinator_degree_slide = pollinator_degree_boxplot +
labs(
x = NULL,
y = NULL,
title = "Pollinators") +
theme(
panel.background = element_rect(
fill = "transparent",
colour = NA),
plot.background = element_rect(
fill = "transparent",
colour = NA),
panel.grid = element_blank(),
plot.title = element_text(
colour = "white",
size = 16,
face = "bold",
hjust = 0.5),
axis.text = element_text(
colour = "white",
size = 12),
axis.title = element_text(
colour = "white",
size = 14),
axis.line = element_line(
colour = "white"),
axis.ticks = element_line(
colour = "white"))
degree_combined_slide =
plant_degree_slide +
pollinator_degree_slide
# ==========================================================
