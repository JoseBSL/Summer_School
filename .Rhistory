# ==========================================================
# 10. Combine degree plots for slides
# ==========================================================
slide_theme = theme(
panel.background = element_rect(
fill = "transparent",
colour = NA),
plot.background = element_rect(
fill = "transparent",
colour = NA),
panel.grid = element_blank(),
plot.title = element_text(
colour = "white",
size = 16,
face = "bold",
hjust = 0.5),
axis.text = element_text(
colour = "white",
size = 12),
axis.title = element_text(
colour = "white",
size = 14),
axis.line = element_line(
colour = "white"),
axis.ticks = element_line(
colour = "white"),
legend.position = "none"
)
# Plant degree
plant_degree_slide = plant_degree_boxplot +
labs(
x = NULL,
y = "Mean degree",
title = "Plants") +
slide_theme
# Pollinator degree
pollinator_degree_slide = pollinator_degree_boxplot +
labs(
x = NULL,
y = NULL,
title = "Pollinators") +
slide_theme
# Combine plots
degree_combined_slide =
plant_degree_slide +
pollinator_degree_slide &
theme(
plot.background = element_rect(
fill = "transparent",
colour = NA))
degree_combined_slide
# Save with transparent background
ggsave(
"degree_treatment_combined.png",
plot = degree_combined_slide,
width = 10,
height = 5,
units = "in",
dpi = 600,
bg = NA)
# ==========================================================
# 6. Combine selectivity plots for slides
# ==========================================================
slide_theme = theme(
panel.background = element_rect(
fill = "transparent",
colour = NA),
plot.background = element_rect(
fill = "transparent",
colour = NA),
panel.grid = element_blank(),
plot.title = element_text(
colour = "white",
size = 16,
face = "bold",
hjust = 0.5),
axis.text = element_text(
colour = "white",
size = 12),
axis.title = element_text(
colour = "white",
size = 14),
axis.line = element_line(
colour = "white"),
axis.ticks = element_line(
colour = "white"),
legend.position = "none"
)
# ----------------------------------------------------------
# Plant selectivity
# ----------------------------------------------------------
plant_selectivity_slide = plot_plant_selectivity +
labs(
x = NULL,
y = "Mean selectivity (d')",
title = "Plants") +
coord_cartesian(
ylim = c(0, 1)) +
slide_theme
# ----------------------------------------------------------
# Pollinator selectivity
# ----------------------------------------------------------
pollinator_selectivity_slide = plot_pollinator_selectivity +
labs(
x = NULL,
y = NULL,
title = "Pollinators") +
coord_cartesian(
ylim = c(0, 1)) +
slide_theme
# ----------------------------------------------------------
# Combine plots
# ----------------------------------------------------------
selectivity_combined_slide =
plant_selectivity_slide +
pollinator_selectivity_slide &
theme(
plot.background = element_rect(
fill = "transparent",
colour = NA))
selectivity_combined_slide
# ----------------------------------------------------------
# Save figure
# ----------------------------------------------------------
ggsave(
"selectivity_treatment_combined.png",
plot = selectivity_combined_slide,
width = 10,
height = 5,
units = "in",
dpi = 600,
bg = NA)
