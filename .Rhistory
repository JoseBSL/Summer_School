n_interactions <- sum(mat > 0)
pollinator_richness <- sum(colSums(mat) > 0)
# Interaction diversity
p <- mat[mat > 0] / sum(mat)
interaction_diversity <- -sum(p * log(p))
# Interaction evenness
interaction_evenness <-
interaction_diversity / log(n_interactions)
# H2'
H2 <- networklevel(
mat,
index = "H2"
)
# Species-level d'
d_values <- specieslevel(
mat,
index = "d"
)
# Mean plant and pollinator d'
d_plant <- mean(
d_values[["lower level"]][, "d"],
na.rm = TRUE
)
d_pollinator <- mean(
d_values[["higher level"]][, "d"],
na.rm = TRUE
)
tibble(
Visits = n_visits,
Interactions = n_interactions,
Interaction_evenness = interaction_evenness,
Interaction_diversity = interaction_diversity,
Pollinator_richness = pollinator_richness,
H2 = H2,
d_plant = d_plant,
d_pollinator = d_pollinator
)
}) |>
ungroup()
#--------------------------------------------------
# 2. Prepare data for plotting
#--------------------------------------------------
metrics_long <- network_metrics |>
pivot_longer(
cols = c(
Visits,
Interactions,
Interaction_evenness,
Interaction_diversity,
Pollinator_richness,
H2,
d_plant,
d_pollinator
),
names_to = "Metric",
values_to = "Value"
) |>
mutate(
Treatment = factor(
Treatment,
levels = c("Unrestored", "Restored"),
labels = c("U", "R")
),
Metric = factor(
Metric,
levels = c(
"Visits",
"Interactions",
"Interaction_evenness",
"Interaction_diversity",
"Pollinator_richness",
"H2",
"d_plant",
"d_pollinator"
),
labels = c(
"Number of visits",
"Number of interactions",
"Interaction evenness",
"Interaction diversity",
expression(S[poll]),
expression(H[2]*"'"),
expression(d[pl]*"'"),
expression(d[poll]*"'")
)
)
)
make_panel <- function(data, metric, ylab) {
ggplot(
filter(data, Metric == metric),
aes(x = Treatment, y = Value, fill = Treatment)
) +
geom_boxplot(
width = 0.55,
outlier.shape = 16,
outlier.size = 2,
linewidth = 0.5
) +
scale_fill_manual(
values = c("U" = "white", "R" = "grey20")
) +
labs(
x = NULL,
y = ylab
) +
theme_classic(base_size = 11) +
theme(
legend.position = "none",
axis.title.y = element_text(size = 10),
axis.text = element_text(colour = "black"),
axis.line = element_line(linewidth = 0.5),
axis.ticks = element_line(linewidth = 0.5)
)
}
p1 <- make_panel(
metrics_long,
"Number of visits",
"Number of visits"
)
p2 <- make_panel(
metrics_long,
"Number of interactions",
"Number of interactions"
)
p3 <- make_panel(
metrics_long,
"Interaction evenness",
"Interaction evenness"
)
p4 <- make_panel(
metrics_long,
"Interaction diversity",
"Interaction diversity"
)
p5 <- make_panel(
metrics_long,
"S[poll]",
expression(S[poll])
)
p6 <- make_panel(
metrics_long,
"H[2]*\"'\"",
expression(H[2]*"'")
)
p7 <- make_panel(
metrics_long,
"d[pl]*\"'\"",
expression(d[pl]*"'")
)
p8 <- make_panel(
metrics_long,
"d[poll]*\"'\"",
expression(d[poll]*"'")
)
(p1 | p2 | p3 | p4) /
(p5 | p6 | p7 | p8)
############################################################
# Summer School: Network Analysis in R
# Part 3: Analyse data
############################################################
# ==========================================================
# 1. Load libraries
# ==========================================================
library(dplyr)  # Data manipulation
library(tibble)
library(patchwork)
# ==========================================================
# 2. Load data
# ==========================================================
networks_long = read_csv2("data/processed/visitation.networks.long.csv")
#--------------------------------------------------
# 1. Calculate metrics for each network
#--------------------------------------------------
network_metrics <- networks_long |>
group_by(Treatment, Site, `Network ID`) |>
group_modify(~ {
# Plant x pollinator interaction matrix
web <- .x |>
group_by(`Plant species name`, `Pollinator species`) |>
summarise(
visits = sum(`Number of visits`),
.groups = "drop"
) |>
pivot_wider(
names_from = `Pollinator species`,
values_from = visits,
values_fill = 0
)
mat <- web |>
column_to_rownames("Plant species name") |>
as.matrix()
# Basic metrics
n_visits <- sum(mat)
n_interactions <- sum(mat > 0)
pollinator_richness <- sum(colSums(mat) > 0)
# Interaction diversity
p <- mat[mat > 0] / sum(mat)
interaction_diversity <- -sum(p * log(p))
# Interaction evenness
interaction_evenness <-
interaction_diversity / log(n_interactions)
# H2'
H2 <- networklevel(
mat,
index = "H2"
)
# Species-level d'
d_values <- specieslevel(
mat,
index = "d"
)
# Mean plant and pollinator d'
d_plant <- mean(
d_values[["lower level"]][, "d"],
na.rm = TRUE
)
d_pollinator <- mean(
d_values[["higher level"]][, "d"],
na.rm = TRUE
)
tibble(
Visits = n_visits,
Interactions = n_interactions,
Interaction_evenness = interaction_evenness,
Interaction_diversity = interaction_diversity,
Pollinator_richness = pollinator_richness,
H2 = H2,
d_plant = d_plant,
d_pollinator = d_pollinator
)
}) |>
ungroup()
#--------------------------------------------------
# 2. Prepare data for plotting
#--------------------------------------------------
metrics_long <- network_metrics |>
pivot_longer(
cols = c(
Visits,
Interactions,
Interaction_evenness,
Interaction_diversity,
Pollinator_richness,
H2,
d_plant,
d_pollinator
),
names_to = "Metric",
values_to = "Value"
) |>
mutate(
Treatment = factor(
Treatment,
levels = c("Unrestored", "Restored"),
labels = c("U", "R")
),
Metric = factor(
Metric,
levels = c(
"Visits",
"Interactions",
"Interaction_evenness",
"Interaction_diversity",
"Pollinator_richness",
"H2",
"d_plant",
"d_pollinator"
),
labels = c(
"Number of visits",
"Number of interactions",
"Interaction evenness",
"Interaction diversity",
expression(S[poll]),
expression(H[2]*"'"),
expression(d[pl]*"'"),
expression(d[poll]*"'")
)
)
)
make_panel <- function(data, metric, ylab) {
ggplot(
filter(data, Metric == metric),
aes(x = Treatment, y = Value, fill = Treatment)
) +
geom_boxplot(
width = 0.55,
outlier.shape = 16,
outlier.size = 2,
linewidth = 0.5
) +
scale_fill_manual(
values = c("U" = "white", "R" = "grey20")
) +
labs(
x = NULL,
y = ylab
) +
theme_classic(base_size = 11) +
theme(
legend.position = "none",
axis.title.y = element_text(size = 10),
axis.text = element_text(colour = "black"),
axis.line = element_line(linewidth = 0.5),
axis.ticks = element_line(linewidth = 0.5)
)
}
p1 <- make_panel(
metrics_long,
"Number of visits",
"Number of visits"
)
p2 <- make_panel(
metrics_long,
"Number of interactions",
"Number of interactions"
)
p3 <- make_panel(
metrics_long,
"Interaction evenness",
"Interaction evenness"
)
p4 <- make_panel(
metrics_long,
"Interaction diversity",
"Interaction diversity"
)
p5 <- make_panel(
metrics_long,
"S[poll]",
expression(S[poll])
)
p6 <- make_panel(
metrics_long,
"H[2]*\"'\"",
expression(H[2]*"'")
)
p7 <- make_panel(
metrics_long,
"d[pl]*\"'\"",
expression(d[pl]*"'")
)
p8 <- make_panel(
metrics_long,
"d[poll]*\"'\"",
expression(d[poll]*"'")
)
(p1 | p2 | p3 | p4) /
(p5 | p6 | p7 | p8)
library(tidyverse)
networks_long = read_csv2(
"data/processed/visitation.networks.long.csv")
visits = networks_long %>%
filter(Site == "Bernica") %>%
group_by(Treatment, `Network ID`) %>%
summarise(
Visits = sum(`Number of visits`),
.groups = "drop")
# =============================================================
# Species-habitat bipartite network in the Balearic Islands
# 15 commercially important / charismatic species and 5 benthic habitats
# =============================================================
library(igraph)
# ---------------------------------------------------------
# 1. Vertices: species and habitats
# ---------------------------------------------------------
species <- c(
"Epinephelus marginatus",   # Dusky grouper
"Sparus aurata",            # Gilthead seabream
"Diplodus sargus",          # White seabream
"Mullus surmuletus",        # Red mullet
"Dicentrarchus labrax",     # European seabass
"Serranus cabrilla",        # Comber
"Scorpaena scrofa",         # Red scorpionfish
"Thunnus thynnus",          # Atlantic bluefin tuna
"Octopus vulgaris",         # Common octopus
"Sepia officinalis",        # Common cuttlefish
"Palinurus elephas",        # Spiny (red) lobster
"Homarus gammarus",         # European lobster
"Paracentrotus lividus",    # Purple sea urchin
"Pinna nobilis",            # Noble pen shell (protected/charismatic)
"Hippocampus hippocampus"   # Short-snouted seahorse
)
habitats <- c(
"Posidonia oceanica",
"Sandy bottoms",
"Rocky bottoms",
"Coralligenous",
"Maerl"
)
vertices_names <- c(species, habitats)
# ---------------------------------------------------------
# 2. Edges: species-habitat associations
#    (weight = relative habitat use/affinity, scale 1-5)
# ---------------------------------------------------------
edges <- data.frame(
from = c(
# Dusky grouper: rocky and coralligenous (adults in caves/walls)
"Epinephelus marginatus", "Epinephelus marginatus",
# Gilthead seabream: Posidonia (juveniles/feeding) and sandy bottoms
"Sparus aurata", "Sparus aurata",
# White seabream: Posidonia and rocky bottoms
"Diplodus sargus", "Diplodus sargus",
# Red mullet: sandy and rocky bottoms (forages on sediment)
"Mullus surmuletus", "Mullus surmuletus",
# European seabass: sandy, Posidonia and rocky bottoms
"Dicentrarchus labrax", "Dicentrarchus labrax", "Dicentrarchus labrax",
# Comber: rocky and coralligenous
"Serranus cabrilla", "Serranus cabrilla",
# Red scorpionfish: rocky and coralligenous
"Scorpaena scrofa", "Scorpaena scrofa",
# Atlantic bluefin tuna: pelagic, functionally linked to sandy/coastal passage
"Thunnus thynnus",
# Common octopus: rocky, sandy and coralligenous
"Octopus vulgaris", "Octopus vulgaris", "Octopus vulgaris",
# Common cuttlefish: Posidonia (egg-laying) and sandy bottoms
"Sepia officinalis", "Sepia officinalis",
# Spiny lobster: coralligenous and rocky bottoms
"Palinurus elephas", "Palinurus elephas",
# European lobster: rocky bottoms and maerl
"Homarus gammarus", "Homarus gammarus",
# Purple sea urchin: Posidonia and rocky bottoms
"Paracentrotus lividus", "Paracentrotus lividus",
# Noble pen shell: exclusively Posidonia
"Pinna nobilis",
# Short-snouted seahorse: Posidonia and maerl
"Hippocampus hippocampus", "Hippocampus hippocampus"
),
to = c(
"Rocky bottoms", "Coralligenous",
"Posidonia oceanica", "Sandy bottoms",
"Posidonia oceanica", "Rocky bottoms",
"Sandy bottoms", "Rocky bottoms",
"Sandy bottoms", "Posidonia oceanica", "Rocky bottoms",
"Rocky bottoms", "Coralligenous",
"Rocky bottoms", "Coralligenous",
"Sandy bottoms",
"Rocky bottoms", "Sandy bottoms", "Coralligenous",
"Posidonia oceanica", "Sandy bottoms",
"Coralligenous", "Rocky bottoms",
"Rocky bottoms", "Maerl",
"Posidonia oceanica", "Rocky bottoms",
"Posidonia oceanica",
"Posidonia oceanica", "Maerl"
),
stringsAsFactors = FALSE
)
# Weights: relative association strength (1 = occasional, 5 = primary habitat)
weights <- c(
4, 3,       # Dusky grouper
3, 3,       # Gilthead seabream
4, 2,       # White seabream
3, 3,       # Red mullet
2, 3, 3,    # European seabass
4, 3,       # Comber
4, 3,       # Red scorpionfish
2,          # Atlantic bluefin tuna
3, 3, 3,    # Common octopus
5, 2,       # Common cuttlefish
4, 3,       # Spiny lobster
3, 4,       # European lobster
4, 3,       # Purple sea urchin
5,          # Noble pen shell
4, 3        # Short-snouted seahorse
)
stopifnot(length(weights) == nrow(edges))
# ---------------------------------------------------------
# 3. Building the bipartite graph
# ---------------------------------------------------------
bip_graph <- graph_from_data_frame(d = edges, vertices = vertices_names, directed = FALSE)
E(bip_graph)$weight <- weights
V(bip_graph)$type <- bipartite_mapping(bip_graph)$type   # FALSE = species, TRUE = habitats
# ---------------------------------------------------------
# 4. Visualization
# ---------------------------------------------------------
# Node colors by type (species vs habitats)
node_colors <- ifelse(V(bip_graph)$type, "steelblue3", "darkorange2")
# Node size proportional to degree (number of connected habitats/species)
node_size <- 6 + degree(bip_graph) * 1.5
set.seed(42)
plot(bip_graph,
layout = layout_as_bipartite(bip_graph),
vertex.color = node_colors,
vertex.label = V(bip_graph)$name,
vertex.label.cex = 0.7,
vertex.label.color = "black",
vertex.size = node_size,
edge.width = E(bip_graph)$weight / 1.2,
edge.color = adjustcolor("gray40", alpha.f = 0.6),
main = "Species-habitat network: commercially important/charismatic fauna in the Balearic Islands")
legend("bottomright",
legend = c("Species", "Habitats"),
col = c("darkorange2", "steelblue3"),
pch = 19, bty = "n", cex = 0.8)
# ---------------------------------------------------------
# 5. (Optional) Basic network metrics
# ---------------------------------------------------------
# Habitat degree = number of associated species
habitat_degree <- degree(bip_graph)[habitats]
print(sort(habitat_degree, decreasing = TRUE))
# Specialists vs generalists (number of habitats per species)
species_degree <- degree(bip_graph)[species]
print(sort(species_degree, decreasing = TRUE))
# ---------------------------------------------------------
# 5. (Optional) Basic network metrics
# ---------------------------------------------------------
# Habitat degree = number of associated species
habitat_degree <- degree(bip_graph)[habitats]
print(sort(habitat_degree, decreasing = TRUE))
# Specialists vs generalists (number of habitats per species)
species_degree <- degree(bip_graph)[species]
print(sort(species_degree, decreasing = TRUE))
